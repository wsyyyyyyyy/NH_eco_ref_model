# ======================================================================
# 거시 지표 수집 환경변수
# ======================================================================
# 이 파일은 .gitignore:6 에 등록되어 커밋되지 않는다.
# 프로젝트 루트에 두어야 한다 — data_collector.py:51 의 load_dotenv() 가
# 인자 없이 호출되므로 실행 디렉터리부터 상위로 탐색한다.
#
# 사용처: python -m api_data_processing.main ...

# ── API 키 (필수) ─────────────────────────────────────────────────────
# 아래 두 줄의 = 뒤에 발급받은 키를 붙여넣을 것. 따옴표는 쓰지 않는다.

# 한국은행 ECOS OpenAPI — indicators.csv 의 44개 지표에 필요
#   발급: https://ecos.bok.or.kr/api/#/AuthKeyApply  (무료, 즉시 발급)
#   미설정 시 data_collector.py 가 경고를 내고 ECOS 수집이 전부 실패한다.
ECOS_API_KEY=여기에_발급받은_키

# KOSIS 국가통계포털 OpenAPI — PUBLIC 3개 지표에 필요
#   (unemployment_rate / construction_cost_index / unsold_housing)
#   발급: https://kosis.kr/openapi/  (무료, 승인까지 시간이 걸릴 수 있음)
KOSIS_API_KEY=여기에_발급받은_키

# ── 호출 제어 (선택. 비워두면 코드 기본값을 쓴다) ─────────────────────
# 기본값 출처: data_collector.py:53-58, public_data_collector.py:16-17
REQUEST_TIMEOUT=30
REQUEST_SLEEP=0.35
MAX_RETRIES=5
BACKOFF_FACTOR=1.0
ECOS_PAGE_SIZE=1000
